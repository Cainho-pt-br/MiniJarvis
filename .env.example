# ==========================================
# Configurações do Broker (Servidor Central)
# ==========================================
BROKER_PORT=8080
BROKER_DB=./orquestrador.db
HISTORICO_MAX=400
ADMIN_PIN=1234
ORQ_UPLOADS_DIR=./uploads

# ==========================================
# Configurações do Agente Worker
# ==========================================
BROKER_URL=http://127.0.0.1:8080
AGENTE_NOME=meu-worker-1
TAGS=cpu,linux
SINCRONIZAR_CEREBRO_S=900

# ==========================================
# MiniJarvis Nuvem (versão online)
# ==========================================
ANTHROPIC_API_KEY=
IA_MODELO_HAIKU=claude-haiku-5-5
IA_MODELO_SONNET=claude-sonnet-5-5
IA_MODELO_OPUS=claude-opus-5-5
IA_ESFORCO=medium
# Postgres em produção (a Vercel cria DATABASE_URL ao ligar o Neon).
# Sem ela, usa o arquivo SQLite abaixo.
DATABASE_URL=
NUVEM_DB=./nuvem.db
CREDITOS_INICIAIS=120
CREDITOS_POR_DOLAR=1000
# Use 0 apenas para testar em http://localhost
COOKIE_SEGURO=1
# IA_FAKE=1 responde sem chamar a API (para desenvolver sem gastar)

# E-mail (confirmação de conta e código para navegador novo). Sem SMTP_HOST,
# a confirmação fica desligada. Gmail: crie uma "senha de app" em
# https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
# EMAIL_FAKE=1 manda os códigos só para o log (desenvolvimento)

# Quem vê a aba Admin (cadastros, lista de espera, trocar plano)
ADMIN_EMAILS=
# Protege o disparo diário das rotinas pela Vercel
CRON_SECRET=

# Pagamento (Mercado Pago). Token em https://www.mercadopago.com.br/developers
# > Suas integrações > Credenciais de produção. O segredo do webhook aparece ao
# cadastrar a URL https://SEU-SITE/api/pagamentos/webhook em "Webhooks".
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Endereço público do site (para onde o checkout volta)
SITE_URL=
# Aparecem nos termos de uso e na política de privacidade
RESPONSAVEL_LEGAL=
EMAIL_CONTATO=

# Operação sem o dono: teto de gasto de IA por dia (US$; 0 desliga). Passou,
# a IA para até o dia virar e ADMIN_EMAILS recebe um aviso. O cron diário
# também manda um relatório para ADMIN_EMAILS (precisa do SMTP).
TETO_DIARIO_USD=10
# Indicação: créditos para quem entra pelo link, para quem indicou, e o teto
BONUS_INDICADO=100
BONUS_INDICADOR=100
TETO_INDICADOR=1000
