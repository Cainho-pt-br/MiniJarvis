# ==========================================
# Configurações do Broker (Servidor Central)
# ==========================================
BROKER_PORT=8080
BROKER_DB=./orquestrador.db
HISTORICO_MAX=400
ADMIN_PIN=1234
ORQ_UPLOADS_DIR=./uploads

# ==========================================
# Configurações do Agente Worker
# ==========================================
BROKER_URL=http://127.0.0.1:8080
AGENTE_NOME=meu-worker-1
TAGS=cpu,linux
SINCRONIZAR_CEREBRO_S=900

# ==========================================
# MiniJarvis Nuvem (versão online)
# ==========================================
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
IA_ESFORCO=medium
NUVEM_DB=./nuvem.db
CREDITOS_INICIAIS=300
CREDITOS_POR_DOLAR=1000
# Use 0 apenas para testar em http://localhost
COOKIE_SEGURO=1
# IA_FAKE=1 responde sem chamar a API (para desenvolver sem gastar)
